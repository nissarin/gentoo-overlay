+                af=1,
+                flags=MATCH_DST_PREFIX | MATCH_PKT_LEN | MATCH_IS_IP6,
+                dst_ip=self.pg1.remote_ip6,
+                dst_prefix_len=128,
+                pkt_len_min=5000,
+                pkt_len_max=6000,
