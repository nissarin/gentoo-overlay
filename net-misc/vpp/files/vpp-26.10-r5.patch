+                / IP(src=self.pg0.remote_ip4, dst=self.pg1.remote_ip4)
+                / UDP(sport=1234, dport=4444)
+                / Raw(b"\xa5" * (size - 28))
+                for _ in range(N_PKTS)
+            ]
