+    def test_packet_length_spans_buffer_chain(self):
+        """packet length is matched on the whole packet, not the first buffer"""
+        self.add_rule(
+            100,
+            mk_match(
+                flags=MATCH_DST_PREFIX | MATCH_PKT_LEN,
+                dst_ip=self.pg1.remote_ip4,
