+        def p6(size):
+            return [
+                Ether(dst=self.pg0.local_mac, src=self.pg0.remote_mac)
+                / IPv6(src=self.pg0.remote_ip6, dst=self.pg1.remote_ip6)
+                / UDP(sport=1234, dport=4444)
