diff --git a/src/plugins/fastacl/FEATURE.yaml b/src/plugins/fastacl/FEATURE.yaml
new file mode 100644
index 000000000..c7cf3c58a
--- /dev/null
+++ b/src/plugins/fastacl/FEATURE.yaml
@@ -0,0 +1,40 @@
+---
+name: FastACL DDoS Filter
+maintainer: Denys Haryachyy <garyachy@gmail.com>
+features:
+  - RFC 8955/8956 FlowSpec matching:
+      - all 12 match types, IPv4 and IPv6 dual-stack
+      - a rule applies to the family its addresses name, and to both when it
+        names none
+  - Tuple Space Search classifier:
+      - rules grouped by mask shape, so lookup cost scales with the number of
+        distinct shapes rather than the number of rules
+      - keys narrow to a compact 8-byte (IPv4) or 16-byte (IPv6) form when the
+        mask allows
+  - Actions:
+      - drop, and permit to match and forward unchanged
+  - Per-rule traffic sampling:
+      - exact 1-in-N ratio per rule, taken before the action
+      - delivered over the kernel psample netlink channel
+  - Counters:
+      - per-rule packets and bytes in the stats segment
+      - exact per-rule counting on by default, switchable off
+      - aggregate wire-rate telemetry in pps, L3 bps and L1 bps
+  - Routed and bridged operation from one datapath
+
+description: |-
+        FastACL filters packets against an RFC 8955/8956 FlowSpec rule set at
+        line rate, for volumetric DDoS mitigation where the rule count is
+        large, rules change while traffic is running, and the decision is
+        almost always to drop. Rules are classified by Tuple Space Search:
+        rules sharing a mask shape occupy one bihash, so a million rules over
+        two shapes cost the same two probes as two rules would. The action and
+        an exact-match bit are carried in the hash value, so discarding a
+        packet needs no rule dereference. The filter attaches to the
+        ip4-unicast and ip6-unicast arcs and to l2-input-ip4 and l2-input-ip6,
+        so the same rule set serves routed and bridged deployments. Matched
+        packets can be mirrored to Linux over the kernel psample channel
+        before the action is applied, so a rule can show what it dropped.
+
+state: production
+properties: [API, CLI, STATS, MULTITHREAD]
diff --git a/src/plugins/fastacl/fastacl.api b/src/plugins/fastacl/fastacl.api
new file mode 100644
index 000000000..fe0e78b0d
--- /dev/null
+++ b/src/plugins/fastacl/fastacl.api
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * Copyright (c) 2026 FastNetMon (fastnetmon.com)
+ */
+option version = "1.0.0";
+
+import "vnet/interface_types.api";
+import "vnet/ip/ip_types.api";
+
+enum fastacl_action_type : u8 {
+  FASTACL_ACTION_DROP       = 0,
+  FASTACL_ACTION_PERMIT     = 3,
+};
+
+typedef fastacl_match {
+  u32 flags;
+  vl_api_address_t dst_addr;
+  vl_api_address_t src_addr;
+  u8 dst_prefix_len;
+  u8 src_prefix_len;
+  u8 proto;
+  u16 dst_port_min;
+  u16 dst_port_max;
+  u16 src_port_min;
+  u16 src_port_max;
+  u16 either_port_min;
+  u16 either_port_max;
+  u8 icmp_type;
+  u8 icmp_code;
+  u8 tcp_flags_value;
+  u8 tcp_flags_mask;
+  u16 pkt_len_min;
+  u16 pkt_len_max;
+  u8 dscp;
+  u8 fragment_flags;
+  u8 fragment_mask;
+};
+
+typedef fastacl_action {
+  vl_api_fastacl_action_type_t type;
+  u32 sample_ratio;
+  u32 sample_group;
+};
+
+autoendian autoreply define fastacl_rule_add {
+  u32 client_index;
+  u32 context;
+  u32 order;
+  vl_api_fastacl_match_t match;
+  vl_api_fastacl_action_t action;
+};
+
+typedef fastacl_rule_entry {
+  u32 order;
+  vl_api_fastacl_match_t match;
+  vl_api_fastacl_action_t action;
+};
+
+autoendian define fastacl_rule_add_batch {
+  u32 client_index;
+  u32 context;
+  u32 count;
+  vl_api_fastacl_rule_entry_t rules[count];
+};
+
+autoendian define fastacl_rule_add_batch_reply {
+  u32 context;
+  i32 retval;
+  u32 n_added;
+};
+
+autoendian autoreply define fastacl_rule_del {
+  u32 client_index;
+  u32 context;
+  u32 rule_index;
+};
+
+autoendian define fastacl_rule_dump {
+  u32 client_index;
+  u32 context;
+};
+
+autoendian define fastacl_rule_details {
+  u32 context;
+  u32 rule_index;
+  u32 order;
+  vl_api_fastacl_match_t match;
+  vl_api_fastacl_action_t action;
+  u64 packet_count;
+  u64 byte_count;
+  f64 pps;
+  f64 l3_bps;
+  f64 l1_bps;
+  u64 sample_count;
+  u64 sample_missed;
+  u64 generation;
+};
+
+autoendian autoreply define fastacl_counters_clear {
+  u32 client_index;
+  u32 context;
+};
+
+autoendian define fastacl_counters_get {
+  u32 client_index;
+  u32 context;
+};
+
+autoendian define fastacl_counters_get_reply {
+  u32 context;
+  i32 retval;
+  u64 total_processed;
+  u64 total_dropped;
+
+  u64 total_bytes_processed;
+  u64 total_bytes_dropped;
+  f64 total_pps;
+  f64 dropped_pps;
+  f64 total_l3_bps;
+  f64 total_l1_bps;
+  f64 dropped_l3_bps;
+  f64 dropped_l1_bps;
+  u32 n_hit_rules;
+};
+
+autoendian autoreply define fastacl_interface_enable_disable {
+  u32 client_index;
+  u32 context;
+  vl_api_interface_index_t sw_if_index;
+  bool enable_disable;
+};
+
+autoendian autoreply define fastacl_psample_enable {
+  u32 client_index;
+  u32 context;
+  bool enable;
+};
+
+autoendian autoreply define fastacl_rule_del_all {
+  u32 client_index;
+  u32 context;
+};
+
+autoendian autoreply define fastacl_rule_stats_set {
+  u32 client_index;
+  u32 context;
+  bool enable;
+};
diff --git a/src/plugins/fastacl/fastacl.c b/src/plugins/fastacl/fastacl.c
new file mode 100644
index 000000000..3d97ef14c
--- /dev/null
+++ b/src/plugins/fastacl/fastacl.c
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * Copyright (c) 2026 FastNetMon (fastnetmon.com)
+ */
+
+#include <fastacl/fastacl.h>
+#include <vlib/stats/stats.h>
+#include <vnet/plugin/plugin.h>
+#include <vpp/app/version.h>
+#include <vnet/vnet.h>
+#include <vnet/feature/feature.h>
+
+extern int vnet_l2_feature_enable_disable (const char *arc_name, const char *node_name,
+					   u32 sw_if_index, int enable_disable,
+					   void *feature_config, u32 n_feature_config_bytes);
+
+fastacl_main_t fastacl_main;
+
+static clib_error_t *
+fastacl_config (vlib_main_t *vm, unformat_input_t *input)
+{
+  fastacl_main_t *fsm = &fastacl_main;
+  u32 buckets_val;
+  u32 memory_mb_val;
+
+  while (unformat_check_input (input) != UNFORMAT_END_OF_INPUT)
+    {
+      if (unformat (input, "tss-bihash-buckets %u", &buckets_val))
+	fsm->tss_buckets = clib_max (buckets_val, FASTACL_TSS_BUCKETS_MIN);
+      else if (unformat (input, "tuple-merge on"))
+	fsm->tuple_merge = 1;
+      else if (unformat (input, "tuple-merge off"))
+	fsm->tuple_merge = 0;
+      else if (unformat (input, "tss-bihash-memory-mb %u", &memory_mb_val))
+	vlib_log_warn (fsm->log_class, "tss-bihash-memory-mb is accepted for configuration "
+				       "compatibility and has no effect: the classifier tables "
+				       "allocate from the VPP main heap");
+      else if (unformat_skip_white_space (input) &&
+	       unformat_check_input (input) == UNFORMAT_END_OF_INPUT)
+	break;
+      else
+	return clib_error_return (0, "unknown input '%U'", format_unformat_error, input);
+    }
+
+  return 0;
+}
+
+VLIB_CONFIG_FUNCTION (fastacl_config, "fastacl");
+
+static clib_error_t *
+fastacl_init (vlib_main_t *vm)
+{
+  fastacl_main_t *fsm = &fastacl_main;
+  fsm->vlib_main = vm;
+  fsm->vnet_main = vnet_get_main ();
+
+  fsm->tuple_by_mask = hash_create_mem (0, sizeof (fastacl_tuple_mask_t), sizeof (uword));
+
+  fsm->tss_buckets = FASTACL_TSS_BUCKETS_DEFAULT;
+  fsm->tuple_merge = FASTACL_TUPLE_MERGE_DEFAULT;
+  fsm->rule_stats_enabled = 1;
+
+  vec_validate (fsm->per_worker, vlib_num_workers ());
+
+  fsm->log_class = vlib_log_register_class ("fastacl", 0);
+
+  fsm->rule_counters.stat_segment_name = "/fastacl/rule";
+
+  fsm->rule_gen_stat_index = ~0u;
+
+  return 0;
+}
+
+static clib_error_t *
+fastacl_counters_main_loop_enter (vlib_main_t *vm)
+{
+  fastacl_main_t *fsm = &fastacl_main;
+
+  vlib_validate_combined_counter (&fsm->rule_counters, 0);
+  if (fsm->rule_counter_len == 0)
+    fsm->rule_counter_len = 1;
+
+  fsm->rule_gen_stat_index = vlib_stats_add_counter_vector ("/fastacl/rule/gen");
+  if (fsm->rule_gen_stat_index != ~0u)
+    {
+      vlib_stats_validate (fsm->rule_gen_stat_index, 0, 0);
+      fsm->rule_gen_len = 1;
+    }
+
+  return 0;
+}
+
+VLIB_MAIN_LOOP_ENTER_FUNCTION (fastacl_counters_main_loop_enter);
+
+static void
+fastacl_psample_close_all (fastacl_main_t *fsm)
+{
+  fsm->psample_enabled = 0;
+  foreach_fastacl_per_worker (pw, fsm) { fastacl_psample_worker_close (&pw->psample); }
+}
+
+static int
+fastacl_psample_open_all (fastacl_main_t *fsm)
+{
+  foreach_fastacl_per_worker (pw, fsm)
+  {
+    if (fastacl_psample_worker_open (&pw->psample) < 0)
+      return VNET_API_ERROR_SYSCALL_ERROR_1;
+  }
+
+  fsm->psample_enabled = 1;
+  return 0;
+}
+
+int
+fastacl_psample_enable_disable (int enable)
+{
+  fastacl_main_t *fsm = &fastacl_main;
+
+  if (!enable)
+    {
+      fastacl_psample_close_all (fsm);
+      return 0;
+    }
+
+  if (fastacl_psample_init () < 0)
+    return VNET_API_ERROR_FEATURE_DISABLED;
+
+  return fastacl_psample_open_all (fsm);
+}
+
+VLIB_INIT_FUNCTION (fastacl_init);
+
+VNET_FEATURE_INIT (fastacl_filter_ip4, static) = {
+  .arc_name = "ip4-unicast",
+  .node_name = "fastacl-filter",
+  .runs_before = VNET_FEATURES ("ip4-lookup"),
+};
+VNET_FEATURE_INIT (fastacl_filter_ip6, static) = {
+  .arc_name = "ip6-unicast",
+  .node_name = "fastacl-filter",
+  .runs_before = VNET_FEATURES ("ip6-lookup"),
+};
+VNET_FEATURE_INIT (fastacl_filter_l2_ip4, static) = {
+  .arc_name = "l2-input-ip4",
+  .node_name = "fastacl-filter-l2",
+};
+VNET_FEATURE_INIT (fastacl_filter_l2_ip6, static) = {
+  .arc_name = "l2-input-ip6",
+  .node_name = "fastacl-filter-l2",
+};
+
+static const struct
+{
+  const char *arc_name;
+  const char *node_name;
+  u8 is_l2;
+} fastacl_filter_arcs[] = {
+  { "ip4-unicast", "fastacl-filter", 0 },
+  { "ip6-unicast", "fastacl-filter", 0 },
+  { "l2-input-ip4", "fastacl-filter-l2", 1 },
+  { "l2-input-ip6", "fastacl-filter-l2", 1 },
+};
+
+static int
+fastacl_arc_enable_disable (u32 i, u32 sw_if_index, int enable_disable)
+{
+  if (fastacl_filter_arcs[i].is_l2)
+    return vnet_l2_feature_enable_disable (fastacl_filter_arcs[i].arc_name,
+					   fastacl_filter_arcs[i].node_name, sw_if_index,
+					   enable_disable, 0, 0);
+  return vnet_feature_enable_disable (fastacl_filter_arcs[i].arc_name,
+				      fastacl_filter_arcs[i].node_name, sw_if_index, enable_disable,
+				      0, 0);
+}
+
+VLIB_PLUGIN_REGISTER () = {
+  .version = VPP_BUILD_VER,
+  .description = "FastACL DDoS Filter",
+};
+
+static int
+fastacl_interface_apply_arcs (fastacl_main_t *fsm, u32 sw_if_index, int enable_disable)
+{
+  u32 i;
+  int rv = 0;
+
+  for (i = 0; i < ARRAY_LEN (fastacl_filter_arcs); i++)
+    if ((rv = fastacl_arc_enable_disable (i, sw_if_index, enable_disable)))
+      break;
+
+  if (rv)
+    {
+      while (i--)
+	fastacl_arc_enable_disable (i, sw_if_index, !enable_disable);
+      return rv;
+    }
+
+  fsm->enabled_interfaces = clib_bitmap_set (fsm->enabled_interfaces, sw_if_index, enable_disable);
+
+  return 0;
+}
+
+int
+fastacl_interface_enable_disable (u32 sw_if_index, int enable_disable)
+{
+  fastacl_main_t *fsm = &fastacl_main;
+
+  if (!!clib_bitmap_get (fsm->enabled_interfaces, sw_if_index) == !!enable_disable)
+    return 0;
+
+  return fastacl_interface_apply_arcs (fsm, sw_if_index, enable_disable);
+}
+
+static clib_error_t *
+fastacl_sw_interface_add_del (vnet_main_t *vnm, u32 sw_if_index, u32 is_add)
+{
+  fastacl_main_t *fsm = &fastacl_main;
+
+  if (!is_add)
+    fsm->enabled_interfaces = clib_bitmap_set (fsm->enabled_interfaces, sw_if_index, 0);
+
+  return 0;
+}
+
+VNET_SW_INTERFACE_ADD_DEL_FUNCTION (fastacl_sw_interface_add_del);
