-            self.pos += 1;
-        }
-    }
-
-    pub(crate) fn unexpected(&self, expected: &str) -> Error {
-        Error::invalid_filter(format!("Expected {expected} at position {}", self.pos))
-    }
-
-    pub(crate) fn bump(&mut self) {
