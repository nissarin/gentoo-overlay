-            self.pos += 1;
-        }
-
-        let name = &self.input[start..self.pos];
-
-        if is_attr_name(name) {
-            Ok(name)
-        } else {
-            Err(Error::invalid_filter(format!(
-                "Invalid attribute name '{name}' at position {start}"
-            )))
-        }
-    }
-
