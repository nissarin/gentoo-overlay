-impl Plan {
-    fn restrict_to(&mut self, ids: Vec<Id>) {
-        match &mut self.restrict {
-            Some(restrict) => restrict.retain(|id| ids.contains(id)),
-            None => self.restrict = Some(ids),
-        }
-
-        if self.restrict.as_ref().is_some_and(Vec::is_empty) {
-            self.is_empty = true;
-        }
-    }
-}
