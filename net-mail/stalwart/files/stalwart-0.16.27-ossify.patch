-    attr.eq_ignore_ascii_case("name")
-        && path.sub_attr.as_deref().is_some_and(|sub_attr| {
-            ["givenName", "familyName"]
-                .iter()
-                .any(|name| sub_attr.eq_ignore_ascii_case(name))
