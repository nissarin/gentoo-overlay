-        let attribute = GROUP_SCHEMA.resolve_patch_path(path)?;
-
-        if attribute.mutability == Mutability::ReadOnly {
-            return Err(Error::mutability(format!(
-                "The attribute '{path}' is read-only and cannot be modified."
-            ))
-            .into());
-        }
