-}
-
-fn value_as_str<'x>(operation: &'x PatchOperation<'x>) -> Result<&'x str> {
-    operation.value_as_str().ok_or_else(|| {
-        Error::invalid_value(format!(
-            "The attribute '{}' requires a string value.",
