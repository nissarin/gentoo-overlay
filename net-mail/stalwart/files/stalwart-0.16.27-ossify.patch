-    fn parse_word(&mut self) -> &'x str {
-        let bytes = self.input.as_bytes();
-        let start = self.pos;
-
-        while bytes.get(self.pos).is_some_and(u8::is_ascii_alphabetic) {
-            self.pos += 1;
-        }
-
-        &self.input[start..self.pos]
