-                        buf.push('%');
-                        buf.push('{');
-                        buf.push_str(&var_name);
-                        buf.push('}');
-                        buf.push('%');
-                    }
-                } else {
-                    buf.push('%');
-                    buf.push('{');
-                    buf.push_str(&var_name);
-                }
-            } else {
-                buf.push(ch);
-            }
-        }
-
-        if !buf.is_empty() {
