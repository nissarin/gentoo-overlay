-    server
-        .metrics_store()
-        .iterate(
-            IterateParams::new(from_key, to_key).ascending().no_values(),
-            |key, _| {
-                events.push(key.deserialize_be_u64(0)?.into());
-
-                Ok(events.len() < max_results)
-            },
-        )
-        .await
-        .caused_by(trc::location!())
-        .map(|_| events)
-}
