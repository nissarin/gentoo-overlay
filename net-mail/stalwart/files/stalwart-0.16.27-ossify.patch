-                        "Invalid attribute '{sub_name}' within schema extension '{name}'"
-                    )));
-                }
-
-                push(
-                    op,
-                    PatchPath::parse(&sub_name)?
-                        .into_owned()
-                        .with_schema(name.clone()),
-                    Some(value),
-                    result,
-                )?;
-            }
-        } else {
-            push(
-                op,
-                PatchPath::parse(&name)?.into_owned(),
-                Some(value),
-                result,
-            )?;
-        }
-    }
-
-    Ok(())
-}
