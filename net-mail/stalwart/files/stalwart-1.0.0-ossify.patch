-fn split_list(value: Cow<'_, str>) -> Vec<Cow<'_, str>> {
-    match value {
-        Cow::Borrowed(value) => value
-            .split(',')
-            .map(str::trim)
-            .filter(|value| !value.is_empty())
-            .map(Cow::Borrowed)
-            .collect(),
-        Cow::Owned(value) => value
-            .split(',')
-            .map(str::trim)
-            .filter(|value| !value.is_empty())
-            .map(|value| Cow::Owned(value.to_string()))
-            .collect(),
-    }
-}
