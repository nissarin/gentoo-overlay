-trait ScimDispatch {
-    fn dispatch_scim_request(
-        &self,
-        req: &mut HttpRequest,
-        session: &HttpSessionData,
-        access_token: Option<&AccessToken>,
-    ) -> impl Future<Output = Result<HttpResponse>> + Send;
