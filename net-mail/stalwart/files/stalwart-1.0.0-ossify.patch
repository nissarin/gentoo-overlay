-    let mut seen = AHashSet::with_capacity(category_tags.len() * 3 + signal_tags.len() + 2);
-    seen.insert(AI_TAG_UNCERTAIN);
-    seen.insert(AI_TAG_ERROR);
-    category_tags
-        .iter()
-        .flatten()
-        .chain(signal_tags)
-        .map(CompactString::as_str)
-        .find(|tag| !seen.insert(*tag))
