-fn ai_tag(name: &str, suffix: &str) -> CompactString {
-    let mut tag = CompactString::with_capacity(AI_TAG_PREFIX.len() + name.len() + suffix.len());
-    tag.push_str(AI_TAG_PREFIX);
-    tag.extend(name.chars().map(|ch| {
