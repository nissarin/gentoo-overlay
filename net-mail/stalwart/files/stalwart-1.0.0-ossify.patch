-fn push_token(out: &mut String, token: &str) {
-    for ch in token.chars().take(MAX_TOKEN_BYTES) {
-        out.push(
-            if ch.is_ascii_alphanumeric() || matches!(ch, '-' | '.' | '_' | ':' | '/' | '@' | '+') {
-                ch
-            } else {
-                '_'
-            },
-        );
-    }
-}
